    // Initialize application
    function initApp() {
      // Set current date automatically
      const today = new Date();
      const options = { year: 'numeric', month: 'short', day: 'numeric' };
      document.getElementById('eval-date').value = today.toLocaleDateString('en-US', options).toUpperCase();

      // Load dataset from local storage or baseline
      const stored = localStorage.getItem('bulldog_lfx_v2_data');
      if (stored) {
        try {
          dataset = JSON.parse(stored);
        } catch (e) {
          dataset = JSON.parse(JSON.stringify(DEFAULT_PLATOONS));
        }
      } else {
        dataset = JSON.parse(JSON.stringify(DEFAULT_PLATOONS));
      }

      buildTLPForm();
      buildRubricForms();
      loadPlatoonIntoView(currentPlatoonId);
      renderRankings();
      lucide.createIcons();
    }

    // Build the 16 TLP checklist items
    function buildTLPForm() {
      const container = document.getElementById('tlp-items-container');
      container.innerHTML = '';
      TLP_ITEMS.forEach((item, index) => {
        const div = document.createElement('div');
        div.className = "flex items-center justify-between p-2.5 rounded bg-stone-950 border border-stone-800/80 hover:border-stone-700 transition";
        div.innerHTML = `
          <span class="text-xs font-semibold text-stone-200">
            <span class="text-stone-500 font-mono text-[11px] mr-1">${index + 1}.</span> ${item.label}
          </span>
          <div class="flex items-center space-x-1.5">
            <button type="button" id="btn-${item.id}-go" onclick="setTLPValue('${item.id}', true)" class="px-2.5 py-1 text-[10px] font-black rounded border border-stone-700 text-stone-400 hover:text-white">GO</button>
            <button type="button" id="btn-${item.id}-nogo" onclick="setTLPValue('${item.id}', false)" class="px-2 py-1 text-[10px] font-black rounded border border-stone-700 text-stone-400 hover:text-white">NO-GO</button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    // Build Tactical 1-4 Rubrics for Day and Night
    function buildRubricForms() {
      ['day', 'night'].forEach(mode => {
        const container = document.getElementById(`${mode}-rubric-container`);
        container.innerHTML = '';

        RUBRIC_CATEGORIES.forEach(cat => {
          const groupDiv = document.createElement('div');
          groupDiv.className = "p-3.5 rounded bg-stone-950 border border-stone-800/80 space-y-3";
          
          let tasksHtml = '';
          cat.tasks.forEach(task => {
            tasksHtml += `
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-2 border-b border-stone-900 last:border-0 gap-2">
                <span class="text-xs font-medium text-stone-300">${task.label}</span>
                <div class="flex items-center space-x-1" id="group-${mode}-${task.id}">
                  <button type="button" onclick="setScoreValue('${mode}', '${task.id}', 1)" class="scale-btn px-2.5 py-1 text-[10px] font-bold rounded border border-stone-800 text-stone-500 hover:text-stone-300" data-val="1">1: N/O</button>
                  <button type="button" onclick="setScoreValue('${mode}', '${task.id}', 2)" class="scale-btn px-2.5 py-1 text-[10px] font-bold rounded border border-stone-800 text-stone-500 hover:text-stone-300" data-val="2">2: Not Met</button>
                  <button type="button" onclick="setScoreValue('${mode}', '${task.id}', 3)" class="scale-btn px-2.5 py-1 text-[10px] font-bold rounded border border-stone-800 text-stone-500 hover:text-stone-300" data-val="3">3: Met</button>
                  <button type="button" onclick="setScoreValue('${mode}', '${task.id}', 4)" class="scale-btn px-2.5 py-1 text-[10px] font-bold rounded border border-stone-800 text-stone-500 hover:text-stone-300" data-val="4">4: Exceeded</button>
                </div>
              </div>
            `;
          });

          groupDiv.innerHTML = `
            <div class="flex items-center space-x-2 text-xs font-black uppercase text-amber-400 tracking-wider">
              <i data-lucide="${cat.icon}" class="w-3.5 h-3.5"></i>
              <span>${cat.title}</span>
            </div>
            <div class="space-y-1">${tasksHtml}</div>
          `;
          container.appendChild(groupDiv);
        });
      });
    }

    // Switch between Grade and Rankings
    function switchTab(tab) {
      if (tab === 'grade') {
        document.getElementById('view-grade').classList.remove('hidden');
        document.getElementById('view-rankings').classList.add('hidden');
        document.getElementById('btn-tab-grade').className = "px-4 py-2 text-xs font-black uppercase tracking-wider rounded bg-amber-500 text-stone-950 transition-all flex items-center gap-2 shadow";
        document.getElementById('btn-tab-rankings').className = "px-4 py-2 text-xs font-black uppercase tracking-wider rounded bg-stone-800 hover:bg-stone-700 text-stone-300 transition-all flex items-center gap-2";
      } else {
        renderRankings();
        document.getElementById('view-grade').classList.add('hidden');
        document.getElementById('view-rankings').classList.remove('hidden');
        document.getElementById('btn-tab-rankings').className = "px-4 py-2 text-xs font-black uppercase tracking-wider rounded bg-amber-500 text-stone-950 transition-all flex items-center gap-2 shadow";
        document.getElementById('btn-tab-grade').className = "px-4 py-2 text-xs font-black uppercase tracking-wider rounded bg-stone-800 hover:bg-stone-700 text-stone-300 transition-all flex items-center gap-2";
      }
      lucide.createIcons();
    }

