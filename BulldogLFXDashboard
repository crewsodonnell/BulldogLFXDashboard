    function onPlatoonSelected(id) {
      saveCurrentPlatoonData(false);
      currentPlatoonId = id;
      loadPlatoonIntoView(id);
    }

    // Load active platoon into the view
    function loadPlatoonIntoView(id) {
      const p = dataset.find(item => item.id === id);
      if (!p) return;

      document.getElementById('platoon-selector').value = id;
      document.getElementById('eval-name').value = p.evaluator || '';
      document.getElementById('pl-name').value = p.plName || '';
      document.getElementById('psg-name').value = p.psgName || '';
      document.getElementById('brief-duration').value = p.briefMinutes || '';

      // Set TLPs
      TLP_ITEMS.forEach(item => {
        const val = p.tlps && p.tlps[item.id] !== undefined ? p.tlps[item.id] : false;
        highlightTLPButton(item.id, val);
      });

      // Set Day fields
      document.getElementById('day-hits').value = p.day?.hits ?? '';
      document.getElementById('day-time').value = p.day?.time ?? '';
      document.getElementById('day-mov-tech').value = p.day?.movTech ?? 1;
      document.getElementById('day-aoa').value = p.day?.aoa ?? 1;
      document.getElementById('day-cover').value = p.day?.cover ?? 1;

      // Set Day Rubrics
      RUBRIC_CATEGORIES.forEach(cat => {
        cat.tasks.forEach(t => {
          const val = p.day?.scores?.[t.id] || 1;
          highlightRubricButton('day', t.id, val);
        });
      });

      // Set Night fields
      document.getElementById('night-hits').value = p.night?.hits ?? '';
      document.getElementById('night-time').value = p.night?.time ?? '';
      document.getElementById('night-mov-tech').value = p.night?.movTech ?? 1;
      document.getElementById('night-aoa').value = p.night?.aoa ?? 1;
      document.getElementById('night-cover').value = p.night?.cover ?? 1;

      // Set Night Rubrics
      RUBRIC_CATEGORIES.forEach(cat => {
        cat.tasks.forEach(t => {
          const val = p.night?.scores?.[t.id] || 1;
          highlightRubricButton('night', t.id, val);
        });
      });

      document.getElementById('eval-sustains').value = p.sustains || '';
      document.getElementById('eval-improves').value = p.improves || '';

      calculateScores();
    }

    // Button highlight helper for TLPs
    function highlightTLPButton(itemId, isGo) {
      const btnGo = document.getElementById(`btn-${itemId}-go`);
      const btnNoGo = document.getElementById(`btn-${itemId}-nogo`);
      if (!btnGo || !btnNoGo) return;

      if (isGo) {
        btnGo.className = "px-2.5 py-1 text-[10px] font-black rounded bg-emerald-600 text-white border border-emerald-500 shadow-sm";
        btnNoGo.className = "px-2 py-1 text-[10px] font-black rounded border border-stone-800 text-stone-500 hover:text-stone-300";
      } else {
        btnNoGo.className = "px-2 py-1 text-[10px] font-black rounded bg-rose-600 text-white border border-rose-500 shadow-sm";
        btnGo.className = "px-2.5 py-1 text-[10px] font-black rounded border border-stone-800 text-stone-500 hover:text-stone-300";
      }
    }

    function setTLPValue(itemId, isGo) {
      const p = dataset.find(item => item.id === currentPlatoonId);
      if (!p) return;
      if (!p.tlps) p.tlps = {};
      p.tlps[itemId] = isGo;
      highlightTLPButton(itemId, isGo);
      calculateScores();
      autoSave();
    }

    function setAllTLP(isGo) {
      const p = dataset.find(item => item.id === currentPlatoonId);
      if (!p) return;
      if (!p.tlps) p.tlps = {};
      TLP_ITEMS.forEach(item => {
        p.tlps[item.id] = isGo;
        highlightTLPButton(item.id, isGo);
      });
      calculateScores();
      autoSave();
    }

    // Button highlight helper for 1-4 Rubrics
    function highlightRubricButton(mode, taskId, val) {
      const container = document.getElementById(`group-${mode}-${taskId}`);
      if (!container) return;
      const buttons = container.querySelectorAll('.scale-btn');
      buttons.forEach(btn => {
        const btnVal = parseInt(btn.getAttribute('data-val'));
        if (btnVal === val) {
          if (val === 1) btn.className = "scale-btn px-2.5 py-1 text-[10px] font-black rounded bg-stone-700 text-white border border-stone-600";
          else if (val === 2) btn.className = "scale-btn px-2.5 py-1 text-[10px] font-black rounded bg-rose-700 text-white border border-rose-600";
          else if (val === 3) btn.className = "scale-btn px-2.5 py-1 text-[10px] font-black rounded bg-amber-500 text-stone-950 border border-amber-400";
          else if (val === 4) btn.className = "scale-btn px-2.5 py-1 text-[10px] font-black rounded bg-emerald-600 text-white border border-emerald-500";
        } else {
          btn.className = "scale-btn px-2.5 py-1 text-[10px] font-bold rounded border border-stone-800 text-stone-500 hover:text-stone-300";
        }
      });
    }

    function setScoreValue(mode, taskId, val) {
      const p = dataset.find(item => item.id === currentPlatoonId);
      if (!p) return;
      if (!p[mode]) p[mode] = {};
      if (!p[mode].scores) p[mode].scores = {};
      p[mode].scores[taskId] = val;
      highlightRubricButton(mode, taskId, val);
      calculateScores();
      autoSave();
    }

    // Calculate score metrics for current platoon
    function calculateScores() {
      const p = dataset.find(item => item.id === currentPlatoonId);
      if (!p) return;

      // 1. TLP Score (Count of GOs / 16)
      let tlpGoCount = 0;
      TLP_ITEMS.forEach(item => {
        if (p.tlps && p.tlps[item.id] === true) tlpGoCount++;
      });
      const tlpPct = Math.round((tlpGoCount / 16) * 100);
      document.getElementById('tlp-score-display').textContent = `${tlpGoCount} / 16 GO (${tlpPct}%)`;

      // 2. Day Iteration Score
      const dayPct = computeIterationScore('day');
      document.getElementById('day-score-display').textContent = `Score: ${dayPct}%`;

      // 3. Night Iteration Score
      const nightPct = computeIterationScore('night');
      document.getElementById('night-score-display').textContent = `Score: ${nightPct}%`;

      // 4. Overall Composite: 20% TLPs + 40% Day + 40% Night
      const composite = Math.round((tlpPct * 0.20) + (dayPct * 0.40) + (nightPct * 0.40));
      document.getElementById('header-composite-score').textContent = `${composite}%`;

      const badge = getRatingBadge(composite);
      const badgeElem = document.getElementById('header-rating-badge');
      badgeElem.textContent = badge.code;
      badgeElem.className = `px-2 py-0.5 text-xs font-black rounded ${badge.css}`;
    }

    // Computes iteration score from 1-4 rubrics + movement GO/NO-GOs
    function computeIterationScore(mode) {
      const movTech = parseInt(document.getElementById(`${mode}-mov-tech`)?.value || 1);
      const aoa = parseInt(document.getElementById(`${mode}-aoa`)?.value || 1);
      const cover = parseInt(document.getElementById(`${mode}-cover`)?.value || 1);
      const movementGoCount = movTech + aoa + cover; // Max 3

      const p = dataset.find(item => item.id === currentPlatoonId);
      let rubricSum = 0;
      let rubricCount = 0;

      RUBRIC_CATEGORIES.forEach(cat => {
        cat.tasks.forEach(t => {
          rubricCount++;
          const score = p?.[mode]?.scores?.[t.id] || 1;
          rubricSum += score;
        });
      });

      // Max rubric sum = 13 tasks * 4 = 52
      const rubricPct = (rubricSum / (rubricCount * 4)) * 85; // 85% weight
      const movementPct = (movementGoCount / 3) * 15;        // 15% weight
      return Math.round(rubricPct + movementPct);
    }

    function getRatingBadge(score) {
      if (score >= 85) return { code: 'T', label: 'Trained', css: 'bg-emerald-950 text-emerald-400 border border-emerald-800' };
      if (score >= 70) return { code: 'P', label: 'Practicing', css: 'bg-amber-950 text-amber-400 border border-amber-800' };
      return { code: 'U', label: 'Untrained', css: 'bg-rose-950 text-rose-400 border border-rose-800' };
    }

    // Auto-save form changes
    function autoSave() {
      const p = dataset.find(item => item.id === currentPlatoonId);
      if (!p) return;

      p.evaluator = document.getElementById('eval-name').value;
      p.plName = document.getElementById('pl-name').value;
      p.psgName = document.getElementById('psg-name').value;
      p.briefMinutes = parseInt(document.getElementById('brief-duration').value) || 0;

      if (!p.day) p.day = {};
      p.day.hits = parseInt(document.getElementById('day-hits').value) || 0;
      p.day.time = document.getElementById('day-time').value;
      p.day.movTech = parseInt(document.getElementById('day-mov-tech').value) || 0;
      p.day.aoa = parseInt(document.getElementById('day-aoa').value) || 0;
      p.day.cover = parseInt(document.getElementById('day-cover').value) || 0;

      if (!p.night) p.night = {};
      p.night.hits = parseInt(document.getElementById('night-hits').value) || 0;
      p.night.time = document.getElementById('night-time').value;
      p.night.movTech = parseInt(document.getElementById('night-mov-tech').value) || 0;
      p.night.aoa = parseInt(document.getElementById('night-aoa').value) || 0;
      p.night.cover = parseInt(document.getElementById('night-cover').value) || 0;

      p.sustains = document.getElementById('eval-sustains').value;
      p.improves = document.getElementById('eval-improves').value;

      localStorage.setItem('bulldog_lfx_v2_data', JSON.stringify(dataset));
    }

    function saveCurrentPlatoonData(notify = true) {
      autoSave();
      if (notify) {
        alert(`Evaluation committed to record for ${document.getElementById('platoon-selector').selectedOptions[0].text}!`);
      }
    }

    function resetActivePlatoon() {
      if (confirm("Reset current platoon marks to blank?")) {
        const p = dataset.find(item => item.id === currentPlatoonId);
        if (!p) return;
        p.tlps = {};
        p.day = { hits: 0, time: '', movTech: 0, aoa: 0, cover: 0, scores: {} };
        p.night = { hits: 0, time: '', movTech: 0, aoa: 0, cover: 0, scores: {} };
        p.sustains = '';
        p.improves = '';
        p.briefMinutes = 0;
        loadPlatoonIntoView(currentPlatoonId);
        autoSave();
      }
    }

    function resetAllBattalionData() {
      if (confirm("Reset all 9 platoons to initial battalion baseline?")) {
        localStorage.removeItem('bulldog_lfx_v2_data');
        dataset = JSON.parse(JSON.stringify(DEFAULT_PLATOONS));
        loadPlatoonIntoView(currentPlatoonId);
        renderRankings();
        alert("Battalion records reset to baseline.");
      }
    }

    // Helper: calculate complete metrics for any given platoon object
    function getPlatoonComposite(p) {
      let tlpGo = 0;
      TLP_ITEMS.forEach(item => {
        if (p.tlps && p.tlps[item.id] === true) tlpGo++;
      });
      const tlpPct = Math.round((tlpGo / 16) * 100);

      // Day
      const dayMov = (p.day?.movTech || 0) + (p.day?.aoa || 0) + (p.day?.cover || 0);
      let dayRubric = 0;
      RUBRIC_CATEGORIES.forEach(cat => cat.tasks.forEach(t => dayRubric += (p.day?.scores?.[t.id] || 1)));
      const dayPct = Math.round(((dayRubric / 52) * 85) + ((dayMov / 3) * 15));

      // Night
      const nightMov = (p.night?.movTech || 0) + (p.night?.aoa || 0) + (p.night?.cover || 0);
      let nightRubric = 0;
      RUBRIC_CATEGORIES.forEach(cat => cat.tasks.forEach(t => nightRubric += (p.night?.scores?.[t.id] || 1)));
      const nightPct = Math.round(((nightRubric / 52) * 85) + ((nightMov / 3) * 15));

      const composite = Math.round((tlpPct * 0.20) + (dayPct * 0.40) + (nightPct * 0.40));
      return { tlpGo, tlpPct, dayPct, nightPct, composite };
    }

    // RENDER TAB 2: RANKINGS LEADERBOARD
    function renderRankings() {
      const tbody = document.getElementById('rankings-table-body');
      tbody.innerHTML = '';

      // Calculate scores for all platoons & sort descending
      const ranked = dataset.map(p => {
        return { ...p, stats: getPlatoonComposite(p) };
      }).sort((a, b) => b.stats.composite - a.stats.composite);

      let totalScore = 0;
      let countT = 0, countP = 0, countU = 0;
      const coScores = { ABU: [], Bushmaster: [], Coldsteel: [] };

      ranked.forEach((p, index) => {
        const stats = p.stats;
        totalScore += stats.composite;
        coScores[p.company].push(stats.composite);

        if (stats.composite >= 85) countT++;
        else if (stats.composite >= 70) countP++;
        else countU++;

        const badge = getRatingBadge(stats.composite);

        // Rank styling for podium
        let rankBadgeClass = "bg-stone-800 text-stone-300";
        if (index === 0) rankBadgeClass = "bg-amber-500 text-stone-950 font-black";
        else if (index === 1) rankBadgeClass = "bg-stone-300 text-stone-950 font-black";
        else if (index === 2) rankBadgeClass = "bg-amber-700 text-white font-black";

        const tr = document.createElement('tr');
        tr.className = "hover:bg-stone-950/70 transition";
        tr.innerHTML = `
          <td class="py-3 px-3 text-center">
            <span class="inline-block w-6 h-6 rounded-full text-xs flex items-center justify-center mx-auto ${rankBadgeClass}">${index + 1}</span>
          </td>
          <td class="py-3 px-3 font-bold text-stone-200 uppercase">${p.company}</td>
          <td class="py-3 px-3 text-white font-semibold">${p.platoon}</td>
          <td class="py-3 px-3 text-stone-400 text-[11px]">
            <span class="text-white block font-medium">PL: ${p.plName || '--'}</span>
            <span>PSG: ${p.psgName || '--'}</span>
          </td>
          <td class="py-3 px-2 text-center font-mono text-stone-300">${p.briefMinutes ? p.briefMinutes + 'm' : '--'}</td>
          <td class="py-3 px-2 text-center font-mono text-stone-300">${stats.tlpGo}/16 <span class="text-stone-500 text-[10px]">(${stats.tlpPct}%)</span></td>
          <td class="py-3 px-2 text-center font-mono text-stone-300">${stats.dayPct}%</td>
          <td class="py-3 px-2 text-center font-mono text-stone-300">${stats.nightPct}%</td>
          <td class="py-3 px-3 text-right font-mono font-black text-amber-400 text-sm">${stats.composite}%</td>
          <td class="py-3 px-3 text-center">
            <span class="px-2 py-0.5 rounded text-[10px] font-black ${badge.css}">${badge.label}</span>
          </td>
          <td class="py-3 px-3 text-center no-print">
            <button onclick="jumpToGrade('${p.id}')" class="text-amber-400 hover:text-white text-xs underline font-bold">Grade</button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Overall Battalion Metrics
      const bnAvg = Math.round(totalScore / dataset.length);
      document.getElementById('rank-metric-avg').textContent = `${bnAvg}%`;
      const avgBadge = getRatingBadge(bnAvg);
      const avgElem = document.getElementById('rank-metric-badge');
      avgElem.textContent = avgBadge.label;
      avgElem.className = `text-xs px-2 py-0.5 rounded font-bold uppercase ${avgBadge.css}`;

      document.getElementById('rank-metric-top-name').textContent = `${ranked[0].company} - ${ranked[0].platoon}`;
      document.getElementById('rank-metric-top-score').textContent = `Composite: ${ranked[0].stats.composite}%`;

      document.getElementById('rank-count-t').textContent = countT;
      document.getElementById('rank-count-p').textContent = countP;
      document.getElementById('rank-count-u').textContent = countU;

      // Company Averages & Top Company Honor
      let topCo = '';
      let topCoAvg = -1;

      ['ABU', 'Bushmaster', 'Coldsteel'].forEach(coKey => {
        const arr = coScores[coKey];
        const avg = Math.round(arr.reduce((a, b) => a + b, 0) / (arr.length || 1));
        const shortKey = coKey === 'ABU' ? 'abu' : (coKey === 'Bushmaster' ? 'bush' : 'cold');
        document.getElementById(`co-avg-${shortKey}`).textContent = `AVG: ${avg}%`;

        if (avg > topCoAvg) {
          topCoAvg = avg;
          topCo = `${coKey} Company`;
        }

        // Render company card items
        const coContainer = document.getElementById(`co-list-${shortKey}`);
        coContainer.innerHTML = '';
        dataset.filter(item => item.company === coKey).forEach(p => {
          const stats = getPlatoonComposite(p);
          const b = getRatingBadge(stats.composite);
          const div = document.createElement('div');
          div.className = "flex items-center justify-between p-2 rounded bg-stone-950 border border-stone-800/80 cursor-pointer hover:border-amber-500/50 transition";
          div.onclick = () => jumpToGrade(p.id);
          div.innerHTML = `
            <div>
              <span class="text-xs font-bold text-white block">${p.platoon}</span>
              <span class="text-[10px] text-stone-500">PL: ${p.plName || 'N/A'}</span>
            </div>
            <div class="flex items-center space-x-2">
              <span class="text-xs font-mono font-bold text-stone-200">${stats.composite}%</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded font-black ${b.css}">${b.code}</span>
            </div>
          `;
          coContainer.appendChild(div);
        });
      });

      document.getElementById('rank-metric-top-company').textContent = topCo;
      document.getElementById('rank-metric-top-co-avg').textContent = `Average: ${topCoAvg}%`;
    }

    function jumpToGrade(platoonId) {
      loadPlatoonIntoView(platoonId);
      currentPlatoonId = platoonId;
      switchTab('grade');
    }

    // Launch on load
    window.onload = initApp;
  </script>
</body>
</html>
