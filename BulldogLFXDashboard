```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1-327 IN Bulldog | Platoon LFX Scorecard</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            military: {
              950: '#0f120e',
              900: '#181f16',
              800: '#232d20',
              700: '#32402e',
              600: '#465940',
              accent: '#d4af37' // Bastogne Gold
            }
          }
        }
      }
    }
  </script>
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; color: black !important; }
      .print-card { border: 1px solid #ccc !important; background: white !important; color: black !important; }
    }
  </style>
</head>
<body class="bg-stone-950 text-stone-100 min-h-screen flex flex-col font-sans antialiased selection:bg-amber-500 selection:text-black">

  <!-- TOP HEADER & NAVIGATION -->
  <header class="bg-stone-900 border-b border-stone-800 sticky top-0 z-50 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap justify-between items-center gap-4">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 font-black">
          <i data-lucide="shield" class="w-6 h-6"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-lg font-black tracking-wider uppercase text-white">1-327 IN "BULLDOG"</h1>
            <span class="px-2 py-0.5 text-[11px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded">101st ABN DIV (AASLT)</span>
          </div>
          <p class="text-xs text-stone-400">Platoon Live-Fire Evaluation System & Command Leaderboard</p>
        </div>
      </div>

      <!-- EXACT TWO TABS -->
      <nav class="flex items-center space-x-2 no-print">
        <button onclick="switchTab('grade')" id="btn-tab-grade" class="px-4 py-2 text-xs font-black uppercase tracking-wider rounded bg-amber-500 text-stone-950 transition-all flex items-center gap-2 shadow">
          <i data-lucide="clipboard-check" class="w-4 h-4"></i> Grade Platoon
        </button>
        <button onclick="switchTab('rankings')" id="btn-tab-rankings" class="px-4 py-2 text-xs font-black uppercase tracking-wider rounded bg-stone-800 hover:bg-stone-700 text-stone-300 transition-all flex items-center gap-2">
          <i data-lucide="trophy" class="w-4 h-4"></i> Rankings
        </button>
      </nav>
    </div>
  </header>

  <!-- MAIN VIEWPORT -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- ========================================== -->
    <!-- TAB 1: GRADING SHEET                       -->
    <!-- ========================================== -->
    <section id="view-grade" class="space-y-6">
      
      <!-- Administrative Banner & Selectors -->
      <div class="bg-stone-900 border border-stone-800 rounded-lg p-5 shadow">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pb-5 border-b border-stone-800">
          <div>
            <span class="text-xs font-bold text-amber-400 tracking-wider uppercase">Platoon Evaluation Roster</span>
            <div class="mt-1 flex items-center gap-3">
              <select id="platoon-selector" onchange="onPlatoonSelected(this.value)" class="bg-stone-950 text-white font-bold text-base px-3 py-2 rounded border border-stone-700 focus:outline-none focus:border-amber-400 cursor-pointer">
                <optgroup label="ABU COMPANY">
                  <option value="abu-1">ABU Co - 1st Platoon</option>
                  <option value="abu-2">ABU Co - 2nd Platoon</option>
                  <option value="abu-3">ABU Co - 3rd Platoon</option>
                </optgroup>
                <optgroup label="BUSHMASTER COMPANY">
                  <option value="bush-1">Bushmaster Co - 1st Platoon</option>
                  <option value="bush-2">Bushmaster Co - 2nd Platoon</option>
                  <option value="bush-3">Bushmaster Co - 3rd Platoon</option>
                </optgroup>
                <optgroup label="COLDSTEEL COMPANY">
                  <option value="cold-1">Coldsteel Co - 1st Platoon</option>
                  <option value="cold-2">Coldsteel Co - 2nd Platoon</option>
                  <option value="cold-3">Coldsteel Co - 3rd Platoon</option>
                </optgroup>
              </select>
            </div>
          </div>

          <!-- Total Score Output & Save -->
          <div class="flex items-center gap-5">
            <div class="text-right">
              <span class="text-xs text-stone-400 uppercase font-semibold">Overall Composite</span>
              <div class="flex items-baseline justify-end gap-2">
                <span id="header-composite-score" class="text-3xl font-black text-amber-400">0%</span>
                <span id="header-rating-badge" class="px-2 py-0.5 text-xs font-black rounded bg-stone-800 text-stone-300">U</span>
              </div>
            </div>
            <button onclick="saveCurrentPlatoonData(true)" class="bg-amber-500 hover:bg-amber-400 text-stone-950 font-black px-4 py-2.5 rounded text-xs uppercase tracking-wider flex items-center gap-2 shadow transition">
              <i data-lucide="save" class="w-4 h-4"></i> Save Evaluation
            </button>
          </div>
        </div>

        <!-- Leader Info, Date, Evaluator Details -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-5">
          <div>
            <label class="block text-[11px] font-bold text-stone-400 uppercase tracking-wider mb-1">Evaluator / OC/T Name</label>
            <input type="text" id="eval-name" placeholder="e.g., CPT Miller" onchange="autoSave()" class="w-full bg-stone-950 border border-stone-800 rounded px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-400">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-400 uppercase tracking-wider mb-1">Evaluation Date</label>
            <input type="text" id="eval-date" readonly class="w-full bg-stone-950 border border-stone-800 rounded px-3 py-2 text-xs text-amber-300 font-mono font-bold focus:outline-none cursor-not-allowed">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-400 uppercase tracking-wider mb-1">Platoon Leader (PL) Name</label>
            <input type="text" id="pl-name" placeholder="e.g., 1LT Davis" onchange="autoSave()" class="w-full bg-stone-950 border border-stone-800 rounded px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-400">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-400 uppercase tracking-wider mb-1">Platoon Sergeant (PSG) Name</label>
            <input type="text" id="psg-name" placeholder="e.g., SFC Hayes" onchange="autoSave()" class="w-full bg-stone-950 border border-stone-800 rounded px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-400">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-400 uppercase tracking-wider mb-1">Brief Duration (Minutes)</label>
            <input type="number" id="brief-duration" min="0" placeholder="e.g., 38" oninput="autoSave()" class="w-full bg-stone-950 border border-stone-800 rounded px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-400">
          </div>
        </div>
      </div>

      <!-- SECTION 1: TROOP LEADING PROCEDURES (TLPs) -->
      <div class="bg-stone-900 border border-stone-800 rounded-lg p-5 shadow">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-3 border-b border-stone-800 gap-2">
          <div>
            <h2 class="text-base font-black uppercase tracking-wider text-white flex items-center gap-2">
              <i data-lucide="book-open" class="w-4 h-4 text-amber-400"></i> Part I: Troop Leading Procedures (TLPs)
            </h2>
            <p class="text-xs text-stone-400">16 Mandatory Gates • Evaluated as GO or NO-GO</p>
          </div>
          <div class="flex items-center gap-3">
            <span id="tlp-score-display" class="font-mono text-sm font-black text-amber-400">0 / 16 GO (0%)</span>
            <div class="flex gap-1 no-print">
              <button type="button" onclick="setAllTLP(true)" class="px-2 py-1 bg-stone-800 hover:bg-stone-700 text-[10px] font-bold rounded text-emerald-400">All GO</button>
              <button type="button" onclick="setAllTLP(false)" class="px-2 py-1 bg-stone-800 hover:bg-stone-700 text-[10px] font-bold rounded text-rose-400">All NO-GO</button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4" id="tlp-items-container">
          <!-- Dynamically populated checklist -->
        </div>
      </div>

      <!-- SECTION 2: DAY ITERATION -->
      <div class="bg-stone-900 border border-stone-800 rounded-lg p-5 shadow">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-3 border-b border-stone-800 gap-2">
          <div>
            <h2 class="text-base font-black uppercase tracking-wider text-white flex items-center gap-2">
              <i data-lucide="sun" class="w-4 h-4 text-amber-400"></i> Part II: Day Live-Fire Iteration
            </h2>
            <p class="text-xs text-stone-400">Maneuver, Marksmanship, SOSA Breaching & Objective Consolidation</p>
          </div>
          <span id="day-score-display" class="font-mono text-sm font-black text-amber-400">Score: 0%</span>
        </div>

        <!-- Objective Stats & Movement to LD -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-4 p-4 rounded bg-stone-950 border border-stone-800/80">
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Hits on Target (Count)</label>
            <input type="number" id="day-hits" min="0" placeholder="e.g., 42" oninput="calculateScores(); autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Time on Objective (mm:ss)</label>
            <input type="text" id="day-time" placeholder="e.g., 18:45" oninput="autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Appropriate Movement Tech</label>
            <select id="day-mov-tech" onchange="calculateScores(); autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
              <option value="1">GO</option>
              <option value="0">NO-GO</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Use of AoAs</label>
            <select id="day-aoa" onchange="calculateScores(); autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
              <option value="1">GO</option>
              <option value="0">NO-GO</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Cover & Concealment</label>
            <select id="day-cover" onchange="calculateScores(); autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
              <option value="1">GO</option>
              <option value="0">NO-GO</option>
            </select>
          </div>
        </div>

        <!-- 1-4 Scaled Tactical Rubrics -->
        <div class="mt-5 space-y-4" id="day-rubric-container">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- SECTION 3: NIGHT ITERATION -->
      <div class="bg-stone-900 border border-stone-800 rounded-lg p-5 shadow">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-3 border-b border-stone-800 gap-2">
          <div>
            <h2 class="text-base font-black uppercase tracking-wider text-white flex items-center gap-2">
              <i data-lucide="moon" class="w-4 h-4 text-indigo-400"></i> Part III: Night Live-Fire Iteration
            </h2>
            <p class="text-xs text-stone-400">NVG Live Maneuver, IR Discipline, SBF Control & LOA Operations</p>
          </div>
          <span id="night-score-display" class="font-mono text-sm font-black text-indigo-400">Score: 0%</span>
        </div>

        <!-- Objective Stats & Movement to LD -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-4 p-4 rounded bg-stone-950 border border-stone-800/80">
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Hits on Target (Count)</label>
            <input type="number" id="night-hits" min="0" placeholder="e.g., 36" oninput="calculateScores(); autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Time on Objective (mm:ss)</label>
            <input type="text" id="night-time" placeholder="e.g., 22:10" oninput="autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Appropriate Movement Tech</label>
            <select id="night-mov-tech" onchange="calculateScores(); autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
              <option value="1">GO</option>
              <option value="0">NO-GO</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Use of AoAs</label>
            <select id="night-aoa" onchange="calculateScores(); autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
              <option value="1">GO</option>
              <option value="0">NO-GO</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-stone-300 uppercase mb-1">Cover & Concealment</label>
            <select id="night-cover" onchange="calculateScores(); autoSave();" class="w-full bg-stone-900 border border-stone-700 rounded px-2.5 py-1.5 text-xs text-white">
              <option value="1">GO</option>
              <option value="0">NO-GO</option>
            </select>
          </div>
        </div>

        <!-- 1-4 Scaled Tactical Rubrics -->
        <div class="mt-5 space-y-4" id="night-rubric-container">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Evaluator Notes & Action Row -->
      <div class="bg-stone-900 border border-stone-800 rounded-lg p-5 shadow space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-amber-400">Evaluator Observations / AAR Comments</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-emerald-400 mb-1">Key Sustains (Strengths)</label>
            <textarea id="eval-sustains" rows="3" placeholder="Tactical violence of action, communication cadence, marksmanship..." oninput="autoSave();" class="w-full p-2.5 bg-stone-950 border border-stone-800 rounded text-xs text-stone-200 focus:outline-none focus:border-emerald-500"></textarea>
          </div>
          <div>
            <label class="block text-xs font-semibold text-amber-400 mb-1">Key Improves (Deficiencies)</label>
            <textarea id="eval-improves" rows="3" placeholder="SBF shift discipline, EPW search security, CASEVAC staging..." oninput="autoSave();" class="w-full p-2.5 bg-stone-950 border border-stone-800 rounded text-xs text-stone-200 focus:outline-none focus:border-amber-500"></textarea>
          </div>
        </div>
        <div class="flex justify-between items-center pt-2">
          <button onclick="resetActivePlatoon()" class="text-stone-500 hover:text-rose-400 text-xs underline transition">Reset This Platoon's Form</button>
          <button onclick="saveCurrentPlatoonData(true)" class="bg-amber-500 hover:bg-amber-400 text-stone-950 font-black px-6 py-2.5 rounded text-xs uppercase tracking-wider flex items-center gap-2 shadow transition">
            <i data-lucide="check" class="w-4 h-4"></i> Commit & Update Rankings
          </button>
        </div>
      </div>

    </section>

    <!-- ========================================== -->
    <!-- TAB 2: RANKINGS LEADERBOARD                -->
    <!-- ========================================== -->
    <section id="view-rankings" class="hidden space-y-6">
      
      <!-- Top Metrics & Podium -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-stone-900 border border-stone-800 p-4 rounded-lg shadow">
          <span class="text-xs font-semibold uppercase text-stone-400">Battalion LFX Average</span>
          <div class="mt-2 flex items-baseline space-x-2">
            <span id="rank-metric-avg" class="text-3xl font-black text-white">0%</span>
            <span id="rank-metric-badge" class="text-xs px-2 py-0.5 rounded font-bold uppercase bg-stone-800 text-stone-300">CALC</span>
          </div>
          <p class="text-xs text-stone-500 mt-1">Across all 9 evaluated platoons</p>
        </div>

        <div class="bg-stone-900 border border-stone-800 p-4 rounded-lg shadow">
          <span class="text-xs font-semibold uppercase text-stone-400">Top Platoon Honor</span>
          <div class="mt-2">
            <span id="rank-metric-top-name" class="text-lg font-black text-amber-400 truncate block">--</span>
          </div>
          <p id="rank-metric-top-score" class="text-xs text-stone-400 mt-1">Score: --</p>
        </div>

        <div class="bg-stone-900 border border-stone-800 p-4 rounded-lg shadow">
          <span class="text-xs font-semibold uppercase text-stone-400">Top Performing Company</span>
          <div class="mt-2">
            <span id="rank-metric-top-company" class="text-lg font-black text-amber-400 truncate block">--</span>
          </div>
          <p id="rank-metric-top-co-avg" class="text-xs text-stone-400 mt-1">Average: --%</p>
        </div>

        <div class="bg-stone-900 border border-stone-800 p-4 rounded-lg shadow">
          <span class="text-xs font-semibold uppercase text-stone-400">Doctrinal T&EO Distribution</span>
          <div class="mt-2 flex items-center space-x-2 text-xs font-black">
            <span class="text-emerald-400"><span id="rank-count-t">0</span> T</span>
            <span class="text-stone-600">|</span>
            <span class="text-amber-400"><span id="rank-count-p">0</span> P</span>
            <span class="text-stone-600">|</span>
            <span class="text-rose-400"><span id="rank-count-u">0</span> U</span>
          </div>
          <p class="text-xs text-stone-500 mt-1">T (&ge;85%), P (70-84%), U (&lt;70%)</p>
        </div>
      </div>

      <!-- Company Standings Breakdown -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-stone-900 border border-stone-800 rounded-lg p-5 shadow">
          <div class="flex justify-between items-center pb-3 border-b border-stone-800">
            <div>
              <h3 class="text-sm font-extrabold text-white tracking-wide uppercase">ABU COMPANY</h3>
              <p class="text-[11px] text-stone-400">1st, 2nd, & 3rd Platoon</p>
            </div>
            <span id="co-avg-abu" class="px-2.5 py-1 text-xs font-mono font-bold rounded bg-stone-950 text-amber-400 border border-stone-800">0%</span>
          </div>
          <div class="mt-3 space-y-2" id="co-list-abu"></div>
        </div>

        <div class="bg-stone-900 border border-stone-800 rounded-lg p-5 shadow">
          <div class="flex justify-between items-center pb-3 border-b border-stone-800">
            <div>
              <h3 class="text-sm font-extrabold text-white tracking-wide uppercase">BUSHMASTER CO</h3>
              <p class="text-[11px] text-stone-400">1st, 2nd, & 3rd Platoon</p>
            </div>
            <span id="co-avg-bush" class="px-2.5 py-1 text-xs font-mono font-bold rounded bg-stone-950 text-amber-400 border border-stone-800">0%</span>
          </div>
          <div class="mt-3 space-y-2" id="co-list-bush"></div>
        </div>

        <div class="bg-stone-900 border border-stone-800 rounded-lg p-5 shadow">
          <div class="flex justify-between items-center pb-3 border-b border-stone-800">
            <div>
              <h3 class="text-sm font-extrabold text-white tracking-wide uppercase">COLDSTEEL CO</h3>
              <p class="text-[11px] text-stone-400">1st, 2nd, & 3rd Platoon</p>
            </div>
            <span id="co-avg-cold" class="px-2.5 py-1 text-xs font-mono font-bold rounded bg-stone-950 text-amber-400 border border-stone-800">0%</span>
          </div>
          <div class="mt-3 space-y-2" id="co-list-cold"></div>
        </div>
      </div>

      <!-- MASTER BATTALION STANDINGS TABLE -->
      <div class="bg-stone-900 border border-stone-800 rounded-lg p-5 shadow overflow-hidden">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-4 border-b border-stone-800 gap-3">
          <div>
            <h3 class="text-base font-extrabold text-white tracking-wide uppercase">Battalion Leaderboard (1st through 9th)</h3>
            <p class="text-xs text-stone-400">Ranked by total overall composite score (TLPs 20%, Day 40%, Night 40%)</p>
          </div>
          <div class="flex items-center space-x-2 no-print">
            <button onclick="window.print()" class="px-3 py-1.5 text-xs font-bold rounded bg-stone-800 hover:bg-stone-700 text-stone-300 transition flex items-center gap-1.5">
              <i data-lucide="printer" class="w-4 h-4"></i> Print Standings
            </button>
            <button onclick="resetAllBattalionData()" class="px-3 py-1.5 text-xs font-bold rounded bg-stone-800 hover:bg-rose-950 text-stone-400 hover:text-rose-400 transition">
              Reset Baseline
            </button>
          </div>
        </div>

        <div class="overflow-x-auto mt-4">
          <table class="w-full text-left text-xs">
            <thead class="bg-stone-950 text-stone-400 uppercase text-[10px] tracking-wider border-b border-stone-800 font-bold">
              <tr>
                <th class="py-3 px-3 text-center">Rank</th>
                <th class="py-3 px-3">Company</th>
                <th class="py-3 px-3">Platoon</th>
                <th class="py-3 px-3">Leadership (PL / PSG)</th>
                <th class="py-3 px-2 text-center">Brief Time</th>
                <th class="py-3 px-2 text-center">TLPs (16 GOs)</th>
                <th class="py-3 px-2 text-center">Day Iter</th>
                <th class="py-3 px-2 text-center">Night Iter</th>
                <th class="py-3 px-3 text-right">Overall Total</th>
                <th class="py-3 px-3 text-center">Status</th>
                <th class="py-3 px-3 text-center no-print">Action</th>
              </tr>
            </thead>
            <tbody id="rankings-table-body" class="divide-y divide-stone-800">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>

    </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-stone-900 border-t border-stone-800 py-3 text-center text-xs text-stone-500 no-print">
